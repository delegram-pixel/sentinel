// SENTINEL RESEARCH
// Prisma schema
//
// Source of truth for structure:
//   docs/DATABASE-SCHEMA.md as amended by docs/DECISIONS.md (ADR-001 to ADR-022).
//
// Conventions:
//   - UUID primary keys.
//   - Workspace is the tenancy root.
//   - Research records are workspace-scoped even when inherited through a parent.
//   - Evidence content lives in object storage, never in this database.
//   - Constraint checks that Prisma cannot express are added in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity, tenancy, and membership
// ---------------------------------------------------------------------------

enum WorkspaceKind {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  RESEARCHER
  REVIEWER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum PreferredMode {
  GUIDED
  DELEGATED
  BOTH
}

enum ResearchInterest {
  WEB_APPLICATION_SECURITY
  BUG_BOUNTY_RESEARCH
  PENETRATION_TESTING
  API_SECURITY
  SECURITY_EDUCATION
}

model User {
  id                    String             @id @default(uuid()) @db.Uuid
  authProviderId        String             @unique
  email                 String             @unique
  displayName           String
  avatarUrl             String?
  experienceLevel       ExperienceLevel    @default(BEGINNER)
  preferredMode         PreferredMode      @default(GUIDED)
  researchInterests     ResearchInterest[] @default([])
  onboardingCompletedAt DateTime?
  onboardingVersion     Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  ownedWorkspaces        Workspace[]                @relation("WorkspaceOwner")
  memberships            WorkspaceMember[]
  ownedProjects          Project[]                  @relation("ProjectOwner")
  createdInvestigations  Investigation[]            @relation("InvestigationCreator")
  createdObservations    InvestigationObservation[] @relation("ObservationCreator")
  createdHypotheses      Hypothesis[]               @relation("HypothesisCreator")
  createdHypothesisLinks HypothesisObservation[]    @relation("HypothesisObservationCreator")
  createdFindings        Finding[]                  @relation("FindingCreator")
  approvedFindings       Finding[]                  @relation("FindingApprover")
  assessedFindings       Finding[]                  @relation("SeverityAssessor")
  confirmedDuplicates    Finding[]                  @relation("DuplicateConfirmer")
  uploadedEvidence       Evidence[]                 @relation("EvidenceUploader")
  reviewedEvidence       Evidence[]                 @relation("EvidenceRedactionReviewer")
  providerConfigs        AIProviderConfig[]
  requestedTasks         AITask[]                   @relation("AITaskRequester")
  humanReviews           VerificationReview[]       @relation("HumanVerificationReviewer")
  sessionSummaries       SessionSummary[]           @relation("SessionSummaryCreator")
  createdScopeVersions   ScopeVersion[]             @relation("ScopeCreator")
  approvedScopeVersions  ScopeVersion[]             @relation("ScopeApprover")
  uploadedArtifacts      AuthorizationArtifact[]
  createdReports         Report[]                   @relation("ReportCreator")
  approvedReports        Report[]                   @relation("ReportApprover")
  createdReportTemplates ReportTemplate[]
  createdReportRevisions ReportRevision[]
  auditLogs              AuditLog[]
  engagements            Engagement[]
  researchDecisions      ResearchDecision[]
  knowledgeDocuments     KnowledgeDocument[]
}

model Workspace {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  kind        WorkspaceKind @default(PERSONAL)
  ownerId     String        @db.Uuid
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner                  User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                WorkspaceMember[]
  projects               Project[]
  investigations         Investigation[]
  findings               Finding[]
  evidence               Evidence[]
  conversations          AIConversation[]
  aiTasks                AITask[]
  reports                Report[]
  reportTemplates        ReportTemplate[]
  auditLogs              AuditLog[]
  engagements            Engagement[]
  researchDecisions      ResearchDecision[]
  investigationRelations InvestigationRelation[]
  knowledgeSources       KnowledgeSource[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeRelations     KnowledgeRelation[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(RESEARCHER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects, targets, and scope
// ---------------------------------------------------------------------------

enum ProjectType {
  LEARNING_LAB
  BUG_BOUNTY
  AUTHORIZED_ASSESSMENT
  INTERNAL_RESEARCH
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum AssetType {
  DOMAIN
  APPLICATION
  API
  IP_ASSET
  LOCAL_LAB
  OTHER
}

enum EnvironmentType {
  PRACTICE_LAB
  BUG_BOUNTY_PROGRAM
  AUTHORIZED_ASSESSMENT
  INTERNAL_ENVIRONMENT
}

enum TargetAuthorizationStatus {
  PENDING
  AUTHORIZED
  EXPIRED
  REVOKED
  UNVERIFIED
}

enum ScopeStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  EXPIRED
  REVOKED
}

enum ScopeAssetMatchType {
  EXACT
  DOMAIN
  SUBDOMAIN
  CIDR
  URL_PREFIX
}

enum ScopeAssetEffect {
  ALLOWED
  EXCLUDED
}

enum ScopeActivityEffect {
  PERMITTED
  PROHIBITED
}

enum Capability {
  READ_PROJECT_CONTEXT
  READ_INVESTIGATION_CONTEXT
  AI_ANALYZE_SUPPLIED_CONTENT
  AI_ANALYZE_TARGET_CONTEXT
  EXPORT_REPORT
  MODIFY_SCOPE
  PASSIVE_FETCH
  ACTIVE_TEST
  BROWSE_WEB
  EXECUTE_COMMAND
  SUBMIT_EXTERNAL_REPORT
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  ownerId     String        @db.Uuid
  name        String
  slug        String
  description String?
  projectType ProjectType   @default(LEARNING_LAB)
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  targets        Target[]
  investigations Investigation[]
  engagements    Engagement[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}

model Target {
  id                     String                    @id @default(uuid()) @db.Uuid
  projectId              String                    @db.Uuid
  name                   String
  description            String?
  assetIdentifier        String
  assetType              AssetType
  environmentType        EnvironmentType
  programName            String?
  programUrl             String?
  authorizationStatus    TargetAuthorizationStatus @default(UNVERIFIED)
  authorizationSource    String?
  authorizationDate      DateTime?
  authorizationExpiresAt DateTime?
  authorizationNotes     String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  scopeVersions    ScopeVersion[]
  investigations   Investigation[]
  engagementAssets EngagementAsset[]

  @@unique([projectId, assetIdentifier])
  @@index([projectId])
  @@index([authorizationStatus])
}

model ScopeVersion {
  id               String      @id @default(uuid()) @db.Uuid
  targetId         String      @db.Uuid
  version          Int
  status           ScopeStatus @default(DRAFT)
  attestationNotes String?
  approvedBy       String?     @db.Uuid
  approvedAt       DateTime?
  supersededAt     DateTime?
  effectiveFrom    DateTime?
  effectiveUntil   DateTime?
  createdBy        String      @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  target                   Target                    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  creator                  User                      @relation("ScopeCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver                 User?                     @relation("ScopeApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  assets                   ScopeAsset[]
  activities               ScopeActivityRule[]
  artifacts                AuthorizationArtifact[]
  engagementAuthorizations EngagementAuthorization[]

  @@unique([targetId, version])
  @@index([targetId, status])
}

model ScopeAsset {
  id              String              @id @default(uuid()) @db.Uuid
  scopeVersionId  String              @db.Uuid
  assetIdentifier String
  assetType       AssetType
  matchType       ScopeAssetMatchType @default(EXACT)
  effect          ScopeAssetEffect
  notes           String?
  createdAt       DateTime            @default(now())

  scopeVersion ScopeVersion @relation(fields: [scopeVersionId], references: [id], onDelete: Cascade)

  @@unique([scopeVersionId, assetIdentifier, matchType])
  @@index([scopeVersionId])
}

model ScopeActivityRule {
  id             String              @id @default(uuid()) @db.Uuid
  scopeVersionId String              @db.Uuid
  activity       Capability
  effect         ScopeActivityEffect
  createdAt      DateTime            @default(now())

  scopeVersion ScopeVersion @relation(fields: [scopeVersionId], references: [id], onDelete: Cascade)

  @@unique([scopeVersionId, activity])
  @@index([scopeVersionId])
}

model AuthorizationArtifact {
  id             String   @id @default(uuid()) @db.Uuid
  scopeVersionId String   @db.Uuid
  storageKey     String   @unique
  fileName       String
  mimeType       String
  fileSize       Int
  checksum       String
  uploadedBy     String   @db.Uuid
  createdAt      DateTime @default(now())

  scopeVersion ScopeVersion @relation(fields: [scopeVersionId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([scopeVersionId])
}

// ---------------------------------------------------------------------------
// Investigations, observations, hypotheses, and findings
// ---------------------------------------------------------------------------

enum InvestigationStatus {
  DRAFT
  ACTIVE
  PAUSED
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum ObservationType {
  APPLICATION_BEHAVIOUR
  ROUTE_INFORMATION
  HTTP_METADATA
  USER_NOTE
  AI_OBSERVATION
  OTHER
}

enum ConfidenceLabel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
}

enum HypothesisStatus {
  IDEA
  OBSERVED
  NEEDS_VALIDATION
  CONFIRMED
  NOT_REPRODUCIBLE
  REJECTED
}

enum HypothesisObservationRelationship {
  SUPPORTS
  CONTRADICTS
  CONTEXT
}

enum FindingStatus {
  DRAFT
  NEEDS_VALIDATION
  UNDER_REVIEW
  CONFIRMED
  FALSE_POSITIVE
  REJECTED
  REPORTABLE
  CLOSED
}

enum Severity {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNASSESSED
}

enum ResolutionReason {
  DUPLICATE
  OUT_OF_SCOPE
  INSUFFICIENT_EVIDENCE
  OTHER
}

model Investigation {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @db.Uuid
  projectId    String              @db.Uuid
  targetId     String              @db.Uuid
  title        String
  description  String?
  objective    String?
  category     String?
  status       InvestigationStatus @default(DRAFT)
  createdBy    String              @db.Uuid
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  engagementId String?             @db.Uuid
  phase        ResearchPhase       @default(CONTEXT_GATHERING)

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  target             Target                     @relation(fields: [targetId], references: [id], onDelete: Restrict)
  creator            User                       @relation("InvestigationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  observations       InvestigationObservation[]
  hypotheses         Hypothesis[]
  findings           Finding[]
  evidence           Evidence[]
  conversations      AIConversation[]
  aiTasks            AITask[]
  collaborations     AICollaboration[]
  sessionSummaries   SessionSummary[]
  reports            Report[]
  engagement         Engagement?                @relation(fields: [engagementId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  decisions          ResearchDecision[]
  relatedFrom        InvestigationRelation[]    @relation("InvestigationRelationFrom")
  relatedTo          InvestigationRelation[]    @relation("InvestigationRelationTo")
  knowledgeDocuments KnowledgeDocument[]

  @@unique([id, workspaceId])
  @@index([engagementId])
  @@index([workspaceId, status])
  @@index([projectId, status])
  @@index([targetId])
}

model InvestigationObservation {
  id              String          @id @default(uuid()) @db.Uuid
  investigationId String          @db.Uuid
  title           String
  description     String
  observationType ObservationType
  source          String?
  confidenceLabel ConfidenceLabel @default(UNKNOWN)
  createdBy       String          @db.Uuid
  createdAt       DateTime        @default(now())

  investigation   Investigation           @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  creator         User                    @relation("ObservationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  hypothesisLinks HypothesisObservation[]

  @@index([investigationId, createdAt])
}

model Hypothesis {
  id                    String           @id @default(uuid()) @db.Uuid
  investigationId       String           @db.Uuid
  title                 String
  description           String
  vulnerabilityCategory String?
  missingInformation    String?
  status                HypothesisStatus @default(IDEA)
  createdBy             String           @db.Uuid
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  investigation    Investigation           @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  creator          User                    @relation("HypothesisCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  observationLinks HypothesisObservation[]
  findings         Finding[]
  decisions        ResearchDecision[]

  @@index([investigationId, status])
}

model HypothesisObservation {
  id               String                            @id @default(uuid()) @db.Uuid
  hypothesisId     String                            @db.Uuid
  observationId    String                            @db.Uuid
  relationshipType HypothesisObservationRelationship
  createdBy        String                            @db.Uuid
  createdAt        DateTime                          @default(now())

  hypothesis  Hypothesis               @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
  observation InvestigationObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  creator     User                     @relation("HypothesisObservationCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([hypothesisId, observationId])
  @@index([observationId])
}

model Finding {
  id                    String            @id @default(uuid()) @db.Uuid
  workspaceId           String            @db.Uuid
  investigationId       String            @db.Uuid
  hypothesisId          String?           @db.Uuid
  title                 String
  titleNormalized       String
  description           String
  vulnerabilityCategory String?
  severity              Severity          @default(UNASSESSED)
  severityRationale     String?
  severityAssessedBy    String?           @db.Uuid
  severityAssessedAt    DateTime?
  affectedAsset         String?
  affectedAssetType     AssetType?
  status                FindingStatus     @default(DRAFT)
  resolutionReason      ResolutionReason?
  impact                String?
  remediation           String?
  verifiedAt            DateTime?
  createdBy             String            @db.Uuid
  approvedBy            String?           @db.Uuid
  approvedAt            DateTime?
  duplicateOfId         String?           @db.Uuid
  duplicateConfirmedBy  String?           @db.Uuid
  duplicateConfirmedAt  DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigation       Investigation        @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  hypothesis          Hypothesis?          @relation(fields: [hypothesisId], references: [id], onDelete: SetNull)
  creator             User                 @relation("FindingCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver            User?                @relation("FindingApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  severityAssessor    User?                @relation("SeverityAssessor", fields: [severityAssessedBy], references: [id], onDelete: SetNull)
  duplicateConfirmer  User?                @relation("DuplicateConfirmer", fields: [duplicateConfirmedBy], references: [id], onDelete: SetNull)
  duplicateOf         Finding?             @relation("FindingDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates          Finding[]            @relation("FindingDuplicates")
  evidenceLinks       EvidenceLink[]
  verificationReviews VerificationReview[]
  reportFindings      ReportFinding[]
  decisions           ResearchDecision[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([investigationId, status])
  @@index([investigationId, vulnerabilityCategory])
  @@index([duplicateOfId])
  @@index([titleNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "Finding_titleNormalized_trgm_idx")
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

enum EvidenceType {
  SCREENSHOT
  HTTP_REQUEST
  HTTP_RESPONSE
  TEXT_OBSERVATION
  DOCUMENT
  LOG
  EXTERNAL_REFERENCE
  REPRODUCTION_NOTE
  OTHER
}

enum EvidenceLinkRelationship {
  SUPPORTS
  CONTRADICTS
  CONTEXT
  REPRODUCTION
}

enum RedactionStatus {
  NOT_REVIEWED
  QUARANTINED
  REDACTED
  VERIFIED_SAFE
}

enum RedactionMethod {
  NONE
  CLIENT_MASK
  HUMAN_REVIEW
}

model Evidence {
  id                  String          @id @default(uuid()) @db.Uuid
  workspaceId         String          @db.Uuid
  investigationId     String          @db.Uuid
  evidenceType        EvidenceType
  title               String
  description         String?
  fileName            String
  storageKey          String?         @unique
  quarantineKey       String?         @unique
  mimeType            String
  fileSize            Int
  checksum            String
  source              String?
  redactionStatus     RedactionStatus @default(NOT_REVIEWED)
  redactionMethod     RedactionMethod @default(NONE)
  scanFindings        Json?
  uploadedBy          String          @db.Uuid
  redactionReviewedBy String?         @db.Uuid
  redactionReviewedAt DateTime?
  activatedAt         DateTime?
  version             Int             @default(1)
  supersedesId        String?         @db.Uuid
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  uploadValidatedAt   DateTime?
  collectedAt         DateTime?
  collector           String?

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigation     Investigation          @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  uploader          User                   @relation("EvidenceUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  redactionReviewer User?                  @relation("EvidenceRedactionReviewer", fields: [redactionReviewedBy], references: [id], onDelete: SetNull)
  supersedes        Evidence?              @relation("EvidenceVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy      Evidence[]             @relation("EvidenceVersions")
  links             EvidenceLink[]
  researchLinks     EvidenceResearchLink[]
  assessments       EvidenceAssessment[]

  @@unique([id, workspaceId])
  @@index([investigationId])
  @@index([workspaceId, redactionStatus])
  @@index([supersedesId])
}

model EvidenceLink {
  id               String                   @id @default(uuid()) @db.Uuid
  evidenceId       String                   @db.Uuid
  findingId        String                   @db.Uuid
  relationshipType EvidenceLinkRelationship
  createdAt        DateTime                 @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  finding  Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, findingId, relationshipType])
  @@index([findingId])
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

enum AIProvider {
  ANTHROPIC
  GROQ
  GEMINI
  OPENROUTER
}

// Platform-wide provider limits, shared by all workers and workspaces.
model AIProviderQuota {
  provider        AIProvider
  model           String
  nextRequestAt   DateTime   @default(now())
  windowStartedAt DateTime   @default(now())
  tokens          Int        @default(0)
  requests        Int        @default(0)
  failures        Int        @default(0)
  cooldownUntil   DateTime?
  disabled        Boolean    @default(false)
  lastFailureCode String?

  @@id([provider, model])
}

enum AIConversationMode {
  GUIDED
  DELEGATED
}

enum AIConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AITaskType {
  RECON_ANALYSIS
  ATTACK_SURFACE_ANALYSIS
  HYPOTHESIS_GENERATION
  EVIDENCE_REVIEW
  FALSE_POSITIVE_REVIEW
  FINDING_SUMMARY
  REPORT_GENERATION
  SESSION_SUMMARY
  PATTERN_ANALYSIS
  RESEARCH_CONCLUSION_REVIEW
}

enum AITaskStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum AITaskEventType {
  TASK_CREATED
  PERMISSION_CHECK
  CONTEXT_ASSEMBLY
  TASK_ASSIGNMENT
  AI_PROCESSING
  OUTPUT_VALIDATION
  RESULT_STORAGE
  HUMAN_REVIEW
  TASK_COMPLETED
  TASK_FAILED
  TASK_CANCELLED
  TASK_TIMED_OUT
}

enum ReviewerType {
  AI
  HUMAN
}

enum VerificationConclusion {
  NEEDS_MORE_EVIDENCE
  NOT_REPRODUCIBLE
  FALSE_POSITIVE
  REVIEW_SUPPORTS_CONFIRMATION
  CONFIRMED
  REJECTED
}

enum SummaryAuthorType {
  AI
  HUMAN
}

model AIProviderConfig {
  id                           String     @id @default(uuid()) @db.Uuid
  userId                       String     @db.Uuid
  provider                     AIProvider
  displayName                  String?
  encryptedCredentialReference String?
  defaultModel                 String?
  isActive                     Boolean    @default(true)
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model AIConversation {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @db.Uuid
  investigationId String               @db.Uuid
  title           String
  mode            AIConversationMode   @default(GUIDED)
  provider        AIProvider
  model           String
  status          AIConversationStatus @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  messages      AIMessage[]
  tasks         AITask[]

  @@index([investigationId])
  @@index([workspaceId])
}

model AIMessage {
  operationKey      String?
  id                String        @id @default(uuid()) @db.Uuid
  conversationId    String        @db.Uuid
  role              AIMessageRole
  content           String
  structuredContent Json?
  inputTokens       Int?
  outputTokens      Int?
  createdAt         DateTime      @default(now())
  sourceTaskId      String?       @unique @db.Uuid
  sourceTask        AITask?       @relation(fields: [sourceTaskId], references: [id], onDelete: Restrict)

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, operationKey])
  @@index([conversationId, createdAt])
}

model AITask {
  collaborationId      String?          @db.Uuid
  collaborationStage   String?
  evaluation           Json?
  collaboration        AICollaboration? @relation(fields: [collaborationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  usageUncertain       Boolean          @default(false)
  usageReconciledAt    DateTime?
  id                   String           @id @default(uuid()) @db.Uuid
  workspaceId          String           @db.Uuid
  investigationId      String           @db.Uuid
  conversationId       String?          @db.Uuid
  taskType             AITaskType
  status               AITaskStatus     @default(PENDING)
  assignedRole         String?
  inputContext         Json?
  executionState       Json?
  reservedTokens       Int              @default(0)
  requestHash          String?
  executionJobId       String?          @db.Uuid
  executorToken        String?
  output               Json?
  errorMessage         String?
  failureCode          String?
  provider             AIProvider
  model                String
  promptTemplateId     String
  promptVersion        String
  contextVersion       String
  idempotencyKey       String
  requiredCapabilities Capability[]     @default([])
  inputTokenBudget     Int
  outputTokenBudget    Int
  inputTokens          Int              @default(0)
  outputTokens         Int              @default(0)
  estimatedCostUsd     Decimal          @default(0) @db.Decimal(12, 6)
  correlationId        String?
  requestedBy          String           @db.Uuid
  parentTaskId         String?          @db.Uuid
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigation       Investigation        @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  conversation        AIConversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  requester           User                 @relation("AITaskRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  parentTask          AITask?              @relation("AITaskRetries", fields: [parentTaskId], references: [id], onDelete: SetNull)
  retries             AITask[]             @relation("AITaskRetries")
  events              AITaskEvent[]
  verificationReviews VerificationReview[]
  sessionSummaries    SessionSummary[]     @relation("SessionSummarySourceTask")
  decisions           ResearchDecision[]
  resultMessage       AIMessage?
  attempts            AIExecutionAttempt[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([investigationId, status])
  @@index([conversationId])
  @@index([correlationId])
  @@index([parentTaskId])
  @@index([executionJobId])
  @@index([collaborationId, workspaceId])
}

model AITaskEvent {
  id          String          @id @default(uuid()) @db.Uuid
  taskId      String          @db.Uuid
  eventType   AITaskEventType
  description String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  task AITask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model BackgroundJob {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @db.Uuid
  requestedBy       String              @db.Uuid
  kind              String
  operationKey      String
  payload           Json
  status            BackgroundJobStatus @default(QUEUED)
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(3)
  availableAt       DateTime            @default(now())
  leaseToken        String?
  leaseUntil        DateTime?
  heartbeatAt       DateTime?
  cancelRequestedAt DateTime?
  progress          Int                 @default(0)
  result            Json?
  failureCode       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([workspaceId, operationKey])
  @@index([status, availableAt])
  @@index([leaseUntil])
  @@index([workspaceId, createdAt])
}

model AIExecutionAttempt {
  provider          AIProvider?
  model             String?
  returnedModel     String?
  host              String?
  latencyMs         Int?
  retryCount        Int         @default(0)
  fallbackFrom      String?
  estimatedCostUsd  Decimal?    @db.Decimal(12, 6)
  reservedCostUsd   Decimal     @default(0) @db.Decimal(12, 6)
  delivery          String?
  id                String      @id @default(uuid()) @db.Uuid
  workspaceId       String      @db.Uuid
  taskId            String      @db.Uuid
  sequence          Int
  requestHash       String
  request           Json
  response          Json?
  status            String      @default("STARTED")
  inputTokens       Int         @default(0)
  outputTokens      Int         @default(0)
  providerRequestId String?
  failureCode       String?
  quotaSettled      Boolean     @default(false)
  startedAt         DateTime    @default(now())
  completedAt       DateTime?
  task              AITask      @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([taskId, sequence])
  @@index([workspaceId, taskId])
  @@index([startedAt])
}

model AICollaboration {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @db.Uuid
  investigationId String        @db.Uuid
  jobId           String        @unique @db.Uuid
  taskType        AITaskType
  status          String        @default("RUNNING")
  contextVersion  String
  context         Json
  result          Json?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  tasks           AITask[]
  investigation   Investigation @relation(fields: [investigationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, investigationId])
}

model VerificationReview {
  id                    String                 @id @default(uuid()) @db.Uuid
  findingId             String                 @db.Uuid
  basis                 Json?
  taskId                String?                @db.Uuid
  reviewerType          ReviewerType
  reviewerUserId        String?                @db.Uuid
  conclusion            VerificationConclusion
  supportingEvidence    Json?
  contradictingEvidence Json?
  missingEvidence       Json?
  impactAssessment      String?
  reasoningSummary      String?
  createdAt             DateTime               @default(now())

  finding  Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  task     AITask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewer User?   @relation("HumanVerificationReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([findingId])
  @@index([taskId])
}

model SessionSummary {
  id                  String            @id @default(uuid()) @db.Uuid
  investigationId     String            @db.Uuid
  summary             String
  completedWork       Json?
  rejectedHypotheses  Json?
  unresolvedQuestions Json?
  nextActions         Json?
  generatedByType     SummaryAuthorType
  model               String?
  promptVersion       String?
  sourceTaskId        String?           @db.Uuid
  createdBy           String?           @db.Uuid
  createdAt           DateTime          @default(now())

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  sourceTask    AITask?       @relation("SessionSummarySourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  creator       User?         @relation("SessionSummaryCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([investigationId, createdAt])
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

enum ReportStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  EXPORTED
  ARCHIVED
}

enum ReportFormat {
  MARKDOWN
  PDF
}

enum ReportGenerationSource {
  HUMAN
  AI_ASSISTED
}

enum ReportTemplateScope {
  SYSTEM
  WORKSPACE
}

model Report {
  id              String       @id @default(uuid()) @db.Uuid
  workspaceId     String       @db.Uuid
  investigationId String       @db.Uuid
  templateId      String?      @db.Uuid
  title           String
  status          ReportStatus @default(DRAFT)
  format          ReportFormat @default(MARKDOWN)
  createdBy       String       @db.Uuid
  approvedBy      String?      @db.Uuid
  approvedAt      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigation Investigation    @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  template      ReportTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  creator       User             @relation("ReportCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver      User?            @relation("ReportApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  findings      ReportFinding[]
  revisions     ReportRevision[]

  @@index([workspaceId, status])
  @@index([investigationId, status])
}

model ReportFinding {
  id        String @id @default(uuid()) @db.Uuid
  reportId  String @db.Uuid
  findingId String @db.Uuid
  position  Int

  report  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  finding Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  @@unique([reportId, findingId])
  @@index([findingId])
}

model ReportTemplate {
  id            String              @id @default(uuid()) @db.Uuid
  workspaceId   String?             @db.Uuid
  name          String
  version       Int                 @default(1)
  scope         ReportTemplateScope @default(WORKSPACE)
  sectionSchema Json
  isActive      Boolean             @default(true)
  createdBy     String?             @db.Uuid
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  reports   Report[]

  @@unique([workspaceId, name, version])
  @@index([name, version])
}

model ReportRevision {
  id               String                 @id @default(uuid()) @db.Uuid
  reportId         String                 @db.Uuid
  version          Int
  content          String
  sourceTaskId     String?                @db.Uuid
  evidenceSnapshot Json
  findingSnapshot  Json
  generatedByType  ReportGenerationSource
  model            String?
  promptVersion    String?
  createdBy        String?                @db.Uuid
  createdAt        DateTime               @default(now())

  report  Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  creator User?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([reportId, version])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String?  @db.Uuid
  userId        String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// V2 research foundation. Existing roots and identifiers remain authoritative.
enum EngagementStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ResearchPhase {
  CONTEXT_GATHERING
  ANALYSIS
  HYPOTHESIS_DEVELOPMENT
  EVIDENCE_REVIEW
  HUMAN_REVIEW
  REPORTING
  CLOSED
}

enum KnowledgeReviewStatus {
  DRAFT
  REVIEWED
  WITHDRAWN
}

enum KnowledgeOrigin {
  USER_NOTE
  PUBLIC_REFERENCE
  IMPORTED_RESULT
  AI_INTERPRETATION
  HUMAN_REVIEWED
}

enum ResearchDecisionKind {
  RESEARCH_NOTE
  MORE_RESEARCH
  REJECT_HYPOTHESIS
  ADOPT_AI_RESULT
  CLOSE_INVESTIGATION
  CLOSE_FINDING
}

model Engagement {
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @db.Uuid
  projectId          String              @db.Uuid
  name               String
  objective          String?
  engagementType     ProjectType
  status             EngagementStatus    @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  legacyProjectId    String?             @unique @db.Uuid
  createdBy          String              @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project            Project             @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  creator            User                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  assets             EngagementAsset[]
  investigations     Investigation[]
  knowledgeDocuments KnowledgeDocument[]
  toolImports        ToolImport[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([projectId])
}

model EngagementAsset {
  id             String                    @id @default(uuid()) @db.Uuid
  workspaceId    String                    @db.Uuid
  engagementId   String                    @db.Uuid
  targetId       String                    @db.Uuid
  createdAt      DateTime                  @default(now())
  engagement     Engagement                @relation(fields: [engagementId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  target         Target                    @relation(fields: [targetId], references: [id], onDelete: Restrict)
  authorizations EngagementAuthorization[]

  @@unique([id, workspaceId])
  @@unique([engagementId, targetId])
  @@index([targetId])
}

model EngagementAuthorization {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @db.Uuid
  assetId        String          @db.Uuid
  scopeVersionId String          @db.Uuid
  source         String
  recordedBy     String          @db.Uuid
  recordedAt     DateTime        @default(now())
  asset          EngagementAsset @relation(fields: [assetId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  scope          ScopeVersion    @relation(fields: [scopeVersionId], references: [id], onDelete: Restrict)

  @@unique([assetId, scopeVersionId])
  @@index([workspaceId])
  @@index([scopeVersionId])
}

model ResearchDecision {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @db.Uuid
  investigationId String               @db.Uuid
  findingId       String?              @db.Uuid
  hypothesisId    String?              @db.Uuid
  sourceRefs      Json                 @default("[]")
  sourceTaskId    String?              @db.Uuid
  kind            ResearchDecisionKind @default(RESEARCH_NOTE)
  rationale       String
  createdBy       String               @db.Uuid
  legacySourceId  String?              @unique
  createdAt       DateTime             @default(now())
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigation   Investigation        @relation(fields: [investigationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  finding         Finding?             @relation(fields: [findingId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  hypothesis      Hypothesis?          @relation(fields: [hypothesisId], references: [id], onDelete: Restrict)
  sourceTask      AITask?              @relation(fields: [sourceTaskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  creator         User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([workspaceId, investigationId, createdAt])
  @@index([findingId])
  @@index([sourceTaskId])
}

model InvestigationRelation {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  fromId       String        @db.Uuid
  toId         String        @db.Uuid
  relationship String
  rationale    String
  createdBy    String        @db.Uuid
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  from         Investigation @relation("InvestigationRelationFrom", fields: [fromId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  to           Investigation @relation("InvestigationRelationTo", fields: [toId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([fromId, toId, relationship])
  @@index([workspaceId, toId])
}

model KnowledgeSource {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  origin      KnowledgeOrigin
  title       String
  url         String?
  publishedAt DateTime?
  retrievedAt DateTime?
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  documents   KnowledgeDocument[]

  @@unique([id, workspaceId])
  @@index([workspaceId, origin])
}

model KnowledgeDocument {
  id              String                @id @default(uuid()) @db.Uuid
  workspaceId     String                @db.Uuid
  sourceId        String                @db.Uuid
  engagementId    String?               @db.Uuid
  investigationId String?               @db.Uuid
  title           String
  content         String
  tags            String[]              @default([])
  version         Int                   @default(1)
  reviewStatus    KnowledgeReviewStatus @default(DRAFT)
  reviewedBy      String?               @db.Uuid
  reviewedAt      DateTime?
  createdBy       String                @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  source          KnowledgeSource       @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  engagement      Engagement?           @relation(fields: [engagementId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  investigation   Investigation?        @relation(fields: [investigationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  creator         User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  relationsFrom   KnowledgeRelation[]   @relation("KnowledgeRelationFrom")
  relationsTo     KnowledgeRelation[]   @relation("KnowledgeRelationTo")
  chunks          KnowledgeChunk[]

  @@unique([id, workspaceId])
  @@index([workspaceId, reviewStatus])
  @@index([engagementId])
  @@index([investigationId])
}

model KnowledgeRelation {
  id           String            @id @default(uuid()) @db.Uuid
  workspaceId  String            @db.Uuid
  fromId       String            @db.Uuid
  toId         String            @db.Uuid
  relationship String
  rationale    String
  createdAt    DateTime          @default(now())
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  from         KnowledgeDocument @relation("KnowledgeRelationFrom", fields: [fromId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  to           KnowledgeDocument @relation("KnowledgeRelationTo", fields: [toId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([fromId, toId, relationship])
  @@index([workspaceId, toId])
}

model KnowledgeChunk {
  id                String            @id @default(uuid()) @db.Uuid
  workspaceId       String            @db.Uuid
  documentId        String            @db.Uuid
  documentVersion   Int
  sequence          Int
  startOffset       Int
  endOffset         Int
  content           String
  checksum          String
  processingVersion String
  createdAt         DateTime          @default(now())
  document          KnowledgeDocument @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([documentId, documentVersion, sequence])
  @@index([workspaceId, documentId])
}

model RetrievalRecord {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  engagementId    String?  @db.Uuid
  investigationId String?  @db.Uuid
  query           String
  filters         Json
  results         Json
  strategy        String
  requestedBy     String   @db.Uuid
  createdAt       DateTime @default(now())

  @@index([workspaceId, investigationId, createdAt])
}

model EvidenceResearchLink {
  id            String                   @id @default(uuid()) @db.Uuid
  workspaceId   String                   @db.Uuid
  evidenceId    String                   @db.Uuid
  observationId String?                  @db.Uuid
  hypothesisId  String?                  @db.Uuid
  subjectKey    String
  relationship  EvidenceLinkRelationship
  rationale     String
  createdBy     String                   @db.Uuid
  createdAt     DateTime                 @default(now())
  evidence      Evidence                 @relation(fields: [evidenceId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([evidenceId, subjectKey, relationship])
  @@index([workspaceId])
}

model EvidenceAssessment {
  id           String                @id @default(uuid()) @db.Uuid
  workspaceId  String                @db.Uuid
  evidenceId   String                @db.Uuid
  sourceTaskId String?               @db.Uuid
  assessorType ReviewerType
  assessorId   String?               @db.Uuid
  reviewStatus KnowledgeReviewStatus @default(DRAFT)
  reviewedBy   String?               @db.Uuid
  reviewedAt   DateTime?
  assessment   Json
  basis        Json
  createdAt    DateTime              @default(now())
  evidence     Evidence              @relation(fields: [evidenceId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([sourceTaskId, evidenceId])
  @@index([workspaceId, evidenceId])
}

// Supplied tool results. Originals and individual records are retained permanently.
model ToolImport {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  engagementId   String           @db.Uuid
  createdBy      String           @db.Uuid
  operationKey   String
  fileName       String
  format         String
  sourceTool     String
  rawContent     String
  checksum       String
  parserVersion  String
  mappingVersion String
  fieldMapping   Json
  status         String           @default("QUEUED")
  failureCode    String?
  createdAt      DateTime         @default(now())
  engagement     Engagement       @relation(fields: [engagementId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  records        ImportedResult[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, operationKey])
  @@index([workspaceId, createdAt])
}

model ImportedResult {
  id                   String     @id @default(uuid()) @db.Uuid
  workspaceId          String     @db.Uuid
  importId             String     @db.Uuid
  recordIndex          Int
  sourceRecordId       String?
  canonical            Json
  rawRecord            Json
  fingerprint          String
  duplicateCandidates  Json
  status               String     @default("PENDING")
  reviewedBy           String?    @db.Uuid
  reviewedAt           DateTime?
  reviewRationale      String?
  investigationId      String?    @db.Uuid
  assetId              String?    @db.Uuid
  adoptedObservationId String?    @db.Uuid
  adoptedFindingId     String?    @db.Uuid
  createdAt            DateTime   @default(now())
  import               ToolImport @relation(fields: [importId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([importId, recordIndex])
  @@index([workspaceId, fingerprint])
}

model RemediationPlan {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  findingId   String         @db.Uuid
  title       String
  description String
  status      String         @default("PLANNED")
  createdBy   String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  retests     RetestRecord[]

  @@unique([id, workspaceId])
  @@index([workspaceId, findingId])
}

model RetestRecord {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @db.Uuid
  planId           String          @db.Uuid
  assetId          String          @db.Uuid
  scopeVersionId   String          @db.Uuid
  activity         String
  requestedBy      String          @db.Uuid
  requestRationale String
  requestedAt      DateTime        @default(now())
  suppliedResults  String?
  evidenceIds      Json            @default("[]")
  conclusion       String?
  reviewedBy       String?         @db.Uuid
  reviewedAt       DateTime?
  reviewRationale  String?
  plan             RemediationPlan @relation(fields: [planId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([workspaceId, planId])
}

model SubmissionEvent {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  reportId          String?  @db.Uuid
  findingId         String?  @db.Uuid
  outcome           String
  destination       String
  externalReference String?
  occurredAt        DateTime
  rationale         String
  recordedBy        String   @db.Uuid
  createdAt         DateTime @default(now())

  @@index([workspaceId, occurredAt])
  @@index([reportId])
  @@index([findingId])
}
