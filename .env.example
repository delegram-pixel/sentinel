# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — Neon (ADR-018)
# DATABASE_URL is the pooled runtime connection.
# DIRECT_URL is the direct connection used only for Prisma migrations.
DATABASE_URL=
DIRECT_URL=
# Optional, used by integration tests only.
TEST_DATABASE_URL=

# Authentication — Clerk (ADR-002)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Rate limiting — Upstash Redis (ADR-020)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI provider — platform-owned key (ADR-006, ADR-033)
AI_PROVIDER=GROQ
GROQ_API_KEY=
# Enable Zero Data Retention in Groq Console > Settings > Data Controls first.
# This flag records the operator's confirmation; it does not change Groq settings.
GROQ_ZDR_ENABLED=
# Published free limits. Lower these if the account has a smaller allowance.
GROQ_TOKENS_PER_MINUTE=8000
GROQ_TOKENS_PER_DAY=200000
GROQ_REQUESTS_PER_DAY=1000
# Optional legacy provider, selected only with AI_PROVIDER=ANTHROPIC.
ANTHROPIC_API_KEY=
# Optional model overrides (ADR-025)
AI_RESEARCH_MODEL=
AI_SUMMARY_MODEL=
# Set to true to force the deterministic mock provider (tests/local only)
AI_USE_MOCK_PROVIDER=

# Multi-model routing (ADR-034). LEGACY preserves the Groq setup above.
AI_ROUTING_MODE=LEGACY
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-3.8-flash
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
OPENROUTER_REVIEW_MODEL=nvidia/nemotron-3.5-super-vl
OPENROUTER_SECONDARY_MODEL=qwen/qwen3.8-27b
# Paid inference is denied until opted in with positive spending caps.
# The task cap covers all stages, batches, corrections and fallbacks in a job.
AI_ALLOW_PAID_MODELS=false
AI_MAX_TASK_COST_USD=0
AI_MAX_DAILY_COST_USD=0
# Operator attestations only: configure these controls at the provider first.
# Gemini confidential processing requires paid service and explicit acceptance
# of Google's documented 55-day abuse-monitoring retention.
GEMINI_PAID_API_ENABLED=false
GEMINI_CONFIDENTIAL_DATA_APPROVED=false
OPENROUTER_PRIVACY_APPROVED=false
OPENROUTER_ZDR_ENABLED=false
# Exact contracted endpoint slugs, comma-separated; no generic/free fallback.
OPENROUTER_ALLOWED_PROVIDERS=
# Optional JSON model entries, task/role priorities, retries and quota limits.
# Invalid JSON disables multi-model routing without crashing unrelated features.
# Model overrides require verified registry metadata; see docs/AI-MULTI-MODEL.md.
AI_ROUTING_CONFIG=

# Evidence storage — UploadThing, private ACL (ADR-019)
UPLOADTHING_TOKEN=
# Development-only filesystem fallback when UPLOADTHING_TOKEN is empty.
# Files are written under .data/evidence unless this path is set.
EVIDENCE_LOCAL_DIR=
EVIDENCE_LOCAL_SIGNING_SECRET=

# Logging
LOG_LEVEL=info
