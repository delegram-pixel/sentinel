# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — Neon (ADR-018)
# DATABASE_URL is the pooled runtime connection.
# DIRECT_URL is the direct connection used only for Prisma migrations.
DATABASE_URL=
DIRECT_URL=
# Optional, used by integration tests only.
TEST_DATABASE_URL=

# Authentication — Clerk (ADR-002)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Rate limiting — Upstash Redis (ADR-020)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI provider — platform-owned key (ADR-006)
ANTHROPIC_API_KEY=
# Optional model overrides (ADR-025)
AI_RESEARCH_MODEL=
AI_SUMMARY_MODEL=
# Set to true to force the deterministic mock provider (tests/local only)
AI_USE_MOCK_PROVIDER=

# Object storage — Cloudflare R2, S3-compatible (ADR-019)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Development-only fallback when the storage variables above are empty.
EVIDENCE_LOCAL_SIGNING_SECRET=

# Logging
LOG_LEVEL=info
